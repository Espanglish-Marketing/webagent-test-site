---
const year = new Date().getFullYear();
---
<footer style="background:#f9f9f9;border-top:1px solid #eee;padding:48px 24px 24px;">
  <div style="max-width:1100px;margin:0 auto;">
    <div style="display:flex;gap:48px;flex-wrap:wrap;margin-bottom:32px;">
      <div style="flex:1;min-width:200px;">
        <p style="font-weight:700;font-size:16px;margin-bottom:8px;">WebAgent Test Site</p>
        <p style="font-size:13px;color:#666;">Providing quality service to our community.</p>
      </div>
      <div style="flex:1;min-width:200px;">
        <p style="font-weight:600;font-size:13px;margin-bottom:12px;text-transform:uppercase;letter-spacing:.05em;">Quick Links</p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:8px;">
          <li><a href="/" style="font-size:13px;color:#555;">Home</a></li>
          <li><a href="/servicios" style="font-size:13px;color:#555;">Services</a></li>
          <li><a href="/contacto" style="font-size:13px;color:#555;">Contact</a></li>
        </ul>
      </div>
    </div>
    <div style="border-top:1px solid #eee;padding-top:20px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;">
      <p style="font-size:12px;color:#999;">&copy; {year} WebAgent Test Site. All rights reserved.</p>
      <p style="font-size:12px;color:#999;">Privacy Notice | HIPAA Compliant</p>
    </div>
  </div>
</footer>
